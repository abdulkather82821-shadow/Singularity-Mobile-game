; Engine configuration file.
; SINGULARITY: Vessel of the Fallen — Godot 4 project
; Open this folder in Godot 4.3+ (Project Manager → Import → project.godot)

config_version=5

[application]

config/name="SINGULARITY: Vessel of the Fallen"
config/description="SINGULARITY: Vessel of the Fallen - a stylised 2D anime action-RPG in Godot 4. Three stages, procedural art and audio, and three endings."
run/main_scene="res://res/scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.015, 0.024, 0.06, 1)
boot_splash/show_image=false

[autoload]

GameConfig="*res://res/scripts/game_config.gd"
SaveManager="*res://res/scripts/save_manager.gd"
AudioManager="*res://res/scripts/audio_manager.gd"
StoryManager="*res://res/scripts/story_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

